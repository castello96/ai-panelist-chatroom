# Copy to .env.local and fill in the providers you want to use.
# .env.local is gitignored. These are read server-side only and are never
# sent to the browser: /api/providers returns booleans and model lists, not keys.
#
# You do not need all three. The app spreads the default panelist seats across
# whichever providers have a key, and hides the rest in the config panel.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
